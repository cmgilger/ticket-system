extends layout

block content
  section.section
    .container.narrow-sm
      h1 Log In
      if error
        .flash.flash-error(role='alert')= error
      form.card.form(method='post' action='/login')
        input(type='hidden' name='next' value=next)
        label
          span Username
          input(type='text' name='username' required autocomplete='username' value=username autofocus)
        label
          span Password
          input(type='password' name='password' required autocomplete='current-password')
        button.btn.btn-block(type='submit') Log In
      p.center
        | New here?
        |
        a(href='/register') Create an account
