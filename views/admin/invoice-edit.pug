extends ../layout
include ../mixins

block content
  section.section
    .container.narrow
      h1 Edit Invoice ##{invoice.id}
      p.meta Billed to #{invoice.full_name} (#{invoice.username}) on #{date(invoice.created_at)}
      +errorList(errors)
      form.card.form(method='post' action=`/admin/invoices/${invoice.id}`)
        .form-row
          label
            span Amount (USD)
            input(type='text' name='amount' inputmode='decimal' required value=form.amount)
          label
            span Status
            select(name='status')
              each s in statuses
                option(value=s selected=s === form.status)= s
        label
          span Reason
          input(type='text' name='reason' required maxlength='300' value=form.reason)
        p.fine-print Set the status to Void to cancel an invoice. Voided invoices are hidden from the client.
        button.btn(type='submit') Save
      p
        a(href='/admin?tab=invoices') ← Back to Invoices
